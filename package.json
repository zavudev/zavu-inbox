{
  "name": "zavu-inbox",
  "version": "0.1.0",
  "private": true,
  "description": "Open source business phone and shared inbox, built on the Zavu API.",
  "license": "Apache-2.0",
  "scripts": {
    "dev": "next dev -p 4100",
    "build": "next build",
    "start": "next start -p 4100",
    "lint": "next lint",
    "test": "vitest run",
    "db:generate": "npm run db:generate:sqlite && npm run db:generate:pg",
    "db:migrate": "node --env-file-if-exists=.env --import tsx lib/db/migrate.ts",
    "db:studio": "drizzle-kit studio --config drizzle.sqlite.config.ts",
    "db:generate:sqlite": "node --env-file-if-exists=.env ./node_modules/.bin/drizzle-kit generate --config drizzle.sqlite.config.ts",
    "db:generate:pg": "node --env-file-if-exists=.env ./node_modules/.bin/drizzle-kit generate --config drizzle.pg.config.ts",
    "db:seed": "node --env-file-if-exists=.env --import tsx lib/db/seed.ts"
  },
  "dependencies": {
    "@libsql/client": "^0.17.4",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "drizzle-orm": "^0.44.7",
    "lucide-react": "^0.554.0",
    "next": "16.0.7",
    "postgres": "^3.4.7",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.4.0",
    "zod": "^3.25.67"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24.10.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.6",
    "tailwindcss": "^4",
    "tsx": "^4.20.6",
    "typescript": "^5",
    "vitest": "^4.0.14"
  }
}
