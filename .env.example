# ---------------------------------------------------------------------------
# Zavu Inbox configuration
# Copy to .env and fill in. Everything except the database comes from Zavu.
# ---------------------------------------------------------------------------

# Database. The dialect is detected from this URL, so switching backends is
# this one line. Pick whichever you already operate:
#
#   file:/data/zavu-inbox.db              SQLite file. No server, no cost. Default.
#   libsql://<db>.turso.io             Turso. Cheapest managed option.
#   postgres://user:pass@host:5432/db  Postgres, if you already run one.
DATABASE_URL=file:./zavu-inbox.db

# Turso only. Leave empty for a local file or for Postgres.
DATABASE_AUTH_TOKEN=

# Zavu API key: dashboard.zavu.dev -> API keys.
# A test-mode key works for a dry run, but nothing is delivered with one.
ZAVU_API_KEY=

# Webhook secret of the sender whose events you point at this app.
# Without it every delivery is rejected, and the inbox will never update.
ZAVU_WEBHOOK_SECRET=

# Public URL of this instance. Used for invitation links and shown in Settings
# as the webhook endpoint to paste into Zavu.
APP_URL=http://localhost:4100

# Shared secret for POST /api/cron/scheduled, which sends scheduled messages.
# Generate one: openssl rand -hex 32
CRON_SECRET=

# Optional. Defaults to the public API.
# ZAVU_API_URL=https://api.zavu.dev
